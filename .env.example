# GTFS-Realtime live feed (optional — falls back to data/raw/trip_updates.json if unset)
GTFS_API_KEY=
GTFS_FEED_URL=https://api.nationaltransport.ie/gtfsr/v2/gtfsr

# Stream backend: "local" (no AWS needed) or "kinesis"
STREAM_BACKEND=local
KINESIS_STREAM_NAME=bus-trip-stream
AWS_REGION=us-east-1

# Replay pacing (seconds between records)
REPLAY_DELAY_SECONDS=1

# Only needed for STREAM_BACKEND=kinesis / AWS deployment
S3_BUCKET=
